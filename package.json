{
  "name": "dsh-doctor",
  "version": "0.9.0-beta.8",
  "private": true,
  "description": "DSH Doctor — 自动诊断 DeepSeek Harness 环境，提供修复建议；用户明确确认后才备份、执行、复检与回滚。默认体检不修改配置。",
  "icon": "icon.svg",
  "author": "YG",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "locale/",
    "scripts/connectivity-probe.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "doctor",
    "diagnostics",
    "health"
  ],
  "license": "Apache-2.0"
}